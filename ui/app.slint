import { Button, LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "TimerOS - trabalho (I02)";
    width: 720px;
    height: 540px;

    in-out property <string> project-name: "";
    in-out property <string> task-name: "";
    in property <string> status-line: "Pronto";
    in property <string> project-metrics: "Sem projeto selecionado";
    in property <string> task-status: "Sem tarefa selecionada";
    in property <string> selected-project-label: "Nenhum projeto";
    in property <string> selected-task-label: "Nenhuma tarefa";
    in property <bool> can-start: false;
    in property <bool> can-pause: false;
    in property <bool> can-resume: false;

    callback create-project(string);
    callback create-task(string);
    callback previous-project();
    callback next-project();
    callback previous-task();
    callback next-task();
    callback start-task();
    callback pause-task();
    callback resume-task();
    callback refresh();

    VerticalBox {
        padding: 18px;
        spacing: 10px;
        alignment: start;
        Text { text: "TimerOS - projeto e tarefa"; font-size: 22px; height: 35px; }

        HorizontalBox {
            height: 42px;
            spacing: 8px;
            LineEdit { text <=> root.project-name; placeholder-text: "Nome do projeto"; }
            Button { text: "Criar projeto"; width: 140px; clicked => { root.create-project(root.project-name); } }
        }
        HorizontalBox {
            height: 42px;
            spacing: 8px;
            LineEdit { text <=> root.task-name; placeholder-text: "Nome da tarefa"; }
            Button { text: "Criar tarefa"; width: 140px; clicked => { root.create-task(root.task-name); } }
        }

        HorizontalBox {
            height: 42px;
            spacing: 8px;
            Button { text: "Projeto anterior"; width: 135px; clicked => { root.previous-project(); } }
            Text { text: root.selected-project-label; overflow: elide; vertical-alignment: center; }
            Button { text: "Próximo projeto"; width: 135px; clicked => { root.next-project(); } }
        }
        HorizontalBox {
            height: 42px;
            spacing: 8px;
            Button { text: "Tarefa anterior"; width: 135px; clicked => { root.previous-task(); } }
            Text { text: root.selected-task-label; overflow: elide; vertical-alignment: center; }
            Button { text: "Próxima tarefa"; width: 135px; clicked => { root.next-task(); } }
        }

        Text { text: root.project-metrics; height: 28px; overflow: elide; vertical-alignment: center; }
        Text { text: root.task-status; height: 28px; overflow: elide; vertical-alignment: center; }

        HorizontalBox {
            height: 42px;
            spacing: 8px;
            Button { text: "Iniciar"; enabled: root.can-start; clicked => { root.start-task(); } }
            Button { text: "Pausar"; enabled: root.can-pause; clicked => { root.pause-task(); } }
            Button { text: "Retomar"; enabled: root.can-resume; clicked => { root.resume-task(); } }
            Button { text: "Atualizar"; clicked => { root.refresh(); } }
        }

        Text { text: root.status-line; height: 54px; wrap: word-wrap; overflow: elide; }
    }
}
